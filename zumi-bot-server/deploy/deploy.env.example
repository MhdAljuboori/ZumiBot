# Copy to deploy.env (git-ignored) and fill in.
VPS_HOST=203.0.113.10
VPS_USER=zumibot
# Optional, defaults to /home/$VPS_USER/zumibot
# VPS_DIR=/home/zumibot/zumibot
# Optional: where the VPS keeps its vault key, for npm run sync. Defaults to ~/.config/zumibot-vault/vault.key
# (the VPS user's home). Set it when the VPS service sets ZUMIBOT_VAULT_KEY_FILE; it must be outside the data folder.
# VPS_VAULT_KEY_FILE=~/.config/zumibot-vault/vault.key
