{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  // Plain TypeScript only. `content.config.ts` and `.astro` files need Astro's generated types (`astro:content`), which a
  // fresh checkout does not have until `astro build`, so `astro build` is their check.
  "include": ["src/sidebar.ts", "src/lib/**/*.ts", "tests/**/*.ts", "vitest.config.ts"]
}
