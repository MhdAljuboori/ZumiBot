{
  "name": "zumibot-monorepo",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "zumi-bot-server/shared",
    "zumi-bot-server/frontend",
    "zumi-bot-server/backend",
    "zumi-bot-desktop",
    "zumi-bot-site",
    "zumi-bot-docs"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node design/zumibot-icon/make-icons.mjs",
    "og-image": "node design/zumibot-og/make-og.mjs",
    "build:server": "npm run build -w @zumibot/frontend && npm run build -w @zumibot/backend",
    "build": "npm run build:server && npm run build -w zumibot",
    "dev": "npm run build:server && npm run dev -w zumibot",
    "browser:check": "node zumi-bot-server/backend/dist/server.mjs browser-check",
    "desktop:check": "node zumi-bot-server/backend/dist/server.mjs desktop-check",
    "browser:install": "node zumi-bot-server/backend/dist/server.mjs browser-install",
    "build:deb": "npm run dist -w zumibot",
    "install:deb": "sudo apt install ./zumi-bot-desktop/dist/ZumiBot_$(node -p \"require('./zumi-bot-desktop/package.json').version\")_amd64.deb",
    "package": "sh zumi-bot-server/deploy/package.sh",
    "sync": "node zumi-bot-server/deploy/sync.mjs",
    "bump:patch": "node zumi-bot-server/deploy/bump.mjs patch",
    "bump:minor": "node zumi-bot-server/deploy/bump.mjs minor",
    "bump:major": "node zumi-bot-server/deploy/bump.mjs major",
    "bump:set": "node zumi-bot-server/deploy/bump.mjs",
    "bump:lock": "npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
    "e2e:desktop": "npm run e2e -w zumibot",
    "e2e:sync": "npm run build && node zumi-bot-desktop/e2e/sync.e2e.mjs",
    "e2e:auth": "npm run build && node zumi-bot-server/e2e/auth.e2e.mjs",
    "e2e:setup": "npm run build && node zumi-bot-server/e2e/setup.e2e.mjs",
    "e2e:allow": "npm run build:server && node zumi-bot-server/e2e/allowBlocked.e2e.mjs",
    "e2e:resilience": "npm run build && node zumi-bot-server/e2e/resilience.e2e.mjs",
    "e2e": "npm run build && node zumi-bot-server/e2e/web.e2e.mjs && node zumi-bot-server/e2e/desktopAskProbe.mjs --soft && node zumi-bot-server/e2e/processAskProbe.mjs --soft && node zumi-bot-server/e2e/sideAskProbe.mjs --soft && node zumi-bot-server/e2e/pauseProbe.mjs --soft && node zumi-bot-server/e2e/vaultGuardProbe.mjs --soft && node zumi-bot-server/e2e/codexProbe.mjs --soft && node zumi-bot-server/e2e/extensionsProbe.mjs --soft && node zumi-bot-server/e2e/thinkingProbe.mjs --soft && node zumi-bot-server/e2e/allowRuleProbe.mjs --soft",
    "probe:allow": "node zumi-bot-server/e2e/allowRuleProbe.mjs",
    "probe:codex": "node zumi-bot-server/e2e/codexProbe.mjs",
    "probe:extensions": "node zumi-bot-server/e2e/extensionsProbe.mjs",
    "probe:sandbox": "npm run build:server && node zumi-bot-server/e2e/sandboxProbe.mjs",
    "smoke:codex": "npm run build && node zumi-bot-server/e2e/codexSmoke.mjs",
    "smoke:acp": "npm run build && node zumi-bot-server/e2e/acpSmoke.mjs",
    "smoke:agui": "npm run build && node zumi-bot-server/e2e/aguiSmoke.mjs",
    "e2e:zumi-bot": "npm run build && node zumi-bot-server/e2e/zumiBot.e2e.mjs",
    "e2e:group": "npm run build && node zumi-bot-server/e2e/group.e2e.mjs",
    "e2e:routines": "npm run build && node zumi-bot-server/e2e/routines.e2e.mjs",
    "e2e:workflows": "npm run build && node zumi-bot-server/e2e/workflows.e2e.mjs",
    "e2e:workflow-room": "npm run build && node zumi-bot-server/e2e/workflowRoom.e2e.mjs",
    "e2e:memory": "npm run build && node zumi-bot-server/e2e/memory.e2e.mjs",
    "e2e:commands": "npm run build && node zumi-bot-server/e2e/commands.e2e.mjs",
    "e2e:usage": "npm run build && node zumi-bot-server/e2e/usage.e2e.mjs",
    "e2e:files": "npm run build && node zumi-bot-server/e2e/files.e2e.mjs",
    "e2e:dispatch": "npm run build && node zumi-bot-server/e2e/dispatch.e2e.mjs",
    "e2e:processes": "npm run build:server && node zumi-bot-server/e2e/processes.e2e.mjs",
    "e2e:pause": "npm run build && node zumi-bot-server/e2e/pause.e2e.mjs",
    "e2e:caps": "npm run build && node zumi-bot-server/e2e/caps.e2e.mjs",
    "e2e:markdown": "npm run build:server && node zumi-bot-server/e2e/markdown.e2e.mjs",
    "e2e:viewer": "npm run build:server && node zumi-bot-server/e2e/viewer.e2e.mjs",
    "e2e:export": "npm run build:server && node zumi-bot-server/e2e/export.e2e.mjs",
    "e2e:audit": "npm run build:server && node zumi-bot-server/e2e/audit.e2e.mjs",
    "e2e:btw": "npm run build && node zumi-bot-server/e2e/btw.e2e.mjs",
    "e2e:versions": "npm run build && node zumi-bot-server/e2e/versions.e2e.mjs",
    "e2e:notifications": "npm run build && node zumi-bot-server/e2e/notifications.e2e.mjs",
    "e2e:unread": "npm run build && node zumi-bot-server/e2e/unread.e2e.mjs",
    "e2e:clone": "npm run build && node zumi-bot-server/e2e/clone.e2e.mjs",
    "e2e:archive": "npm run build && node zumi-bot-server/e2e/archive.e2e.mjs",
    "e2e:worktrees": "npm run build && node zumi-bot-server/e2e/worktrees.e2e.mjs",
    "e2e:search": "npm run build && node zumi-bot-server/e2e/search.e2e.mjs",
    "e2e:palette": "npm run build && node zumi-bot-server/e2e/palette.e2e.mjs",
    "e2e:todos": "npm run build && node zumi-bot-server/e2e/todos.e2e.mjs",
    "e2e:automations": "npm run build && node zumi-bot-server/e2e/automations.e2e.mjs",
    "e2e:board": "npm run build && node zumi-bot-server/e2e/board.e2e.mjs",
    "e2e:attempts": "npm run build && node zumi-bot-server/e2e/attempts.e2e.mjs",
    "e2e:github": "npm run build && node zumi-bot-server/e2e/github.e2e.mjs",
    "e2e:inbox": "npm run build && node zumi-bot-server/e2e/inbox.e2e.mjs",
    "e2e:ask": "npm run build && node zumi-bot-server/e2e/ask.e2e.mjs",
    "e2e:codex": "npm run build && node zumi-bot-server/e2e/codex.e2e.mjs",
    "e2e:acp": "npm run build && node zumi-bot-server/e2e/acp.e2e.mjs",
    "e2e:agui": "npm run build && node zumi-bot-server/e2e/agui.e2e.mjs",
    "e2e:voice": "npm run build && node zumi-bot-server/e2e/voice.e2e.mjs",
    "e2e:telegram": "npm run build:server && node zumi-bot-server/e2e/telegram.e2e.mjs",
    "e2e:slack": "npm run build:server && node zumi-bot-server/e2e/slack.e2e.mjs",
    "e2e:browser": "npm run build && node zumi-bot-server/e2e/browser.e2e.mjs && node zumi-bot-server/e2e/browser-viewer.e2e.mjs",
    "e2e:computer": "npm run build && node zumi-bot-server/e2e/computer.e2e.mjs",
    "e2e:vault": "npm run build && node zumi-bot-server/e2e/vault.e2e.mjs",
    "e2e:extensions": "npm run build && node zumi-bot-server/e2e/extensions.e2e.mjs",
    "e2e:connectors": "npm run build && node zumi-bot-server/e2e/connectors.e2e.mjs",
    "e2e:connectors-probe": "node zumi-bot-server/e2e/connectorsProbe.mjs",
    "shot": "npm run build && node zumi-bot-server/e2e/shot.mjs",
    "docs:shots": "npm run build:server && npm run shots -w @zumibot/docs --",
    "container:image": "node zumi-bot-server/container/build.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "katex": "0.18.10",
    "app-builder-lib": {
      "minimatch@^10": "11.0.4",
      "@electron/universal": {
        "minimatch@^9": "11.0.4"
      }
    }
  }
}
