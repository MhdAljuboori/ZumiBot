# Copy to .env and edit. `.env` is git-ignored.
#
#   cp .env.example .env
#   docker compose up -d
#   docker compose logs zumibot      # the one-time setup code, then open https://<your domain>/setup

# Which setup to run: `domain` (a public https host) or `local` (loopback only).
COMPOSE_PROFILES=domain

# --- COMPOSE_PROFILES=domain ---------------------------------------------------------------------------------
# The host an A (and AAAA) record already points at this machine. Caddy gets the certificate for it, which needs
# port 80 reachable from the internet.
ZUMIBOT_DOMAIN=zumibot.example.com

# --- COMPOSE_PROFILES=local ----------------------------------------------------------------------------------
# No domain: nothing is published beyond the address below. Reach it through an SSH tunnel
# (ssh -L 8443:127.0.0.1:8443 you@host) or over Tailscale (below).
# The port is fixed at 8443: compose publishes ...:8443 and Caddy listens on the origin's own port, so the origin
# must end in :8443 and be exactly what the browser types.
#ZUMIBOT_LOCAL_PUBLISH=127.0.0.1:8443
#ZUMIBOT_LOCAL_ORIGIN=https://localhost:8443
#
# Tailscale: keep the publish on 127.0.0.1:8443, set the origin to this machine's tailnet name, and on the host run
#   tailscale serve --bg --tcp=8443 tcp://127.0.0.1:8443
# (the installer's --origin https://<this-machine>.<tailnet>.ts.net:8443 writes the origin for you). Publishing on
# the tailnet IP instead fails: on Colima that IP is on the Mac, not in the VM, and on Linux tailscaled may start after Docker.
#ZUMIBOT_LOCAL_ORIGIN=https://<this-machine>.<tailnet>.ts.net:8443
# An edit here takes effect after `docker compose up -d` in this folder.

# --- optional ------------------------------------------------------------------------------------------------
# The claude CLI version baked into the image. Only a build from source (docker compose up -d --build) reads it: a
# release's image is already built, with the Dockerfile's pin. Bump deliberately: ZumiBot leans on CLI flags its e2e
# suite checks.
#ZUMIBOT_CLAUDE_VERSION=2.1.325
